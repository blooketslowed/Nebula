Yuji Boku":"YAFGHcN5e_Y,0","Yusei Magic":"YAEhL8RNAMk,0","Zain":"YAHO2lC1Xkw,0","Zalando Sans":"YAHO2k5OK-M,0","Zalando Sans Expanded":"YAHO2h6OPds,0","Zen Kaku Gothic Antique":"YAHO2u8F_xk,0","Zen Kaku Gothic New":"YAHO2tS_yps,0","Zen Maru Gothic":"YAFdJgMrcdw,0","Zen Old Mincho":"YAHO2tMwaEs,0","Zeyada":"YAHO2lP62P0,0","Zilla Slab":"YAFdJpPotmI,0"}}');</script><script src="/_sdk/57e4e8fcf2dffb4b.telemetry_sdk.js" integrity="sha512-tv1Sz/AB6ao/IZ9DHRSu4SNB4EZ38woHzupwg3oRe4DEXvqh7zD0+csVKIT7x4Faf2+81Slx3RXWRoJrv4K2zw=="></script>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Nebula</title>
<style>
  :root { --accent:#7c5cff; --bg:#0b0b14; --panel:rgba(20,20,34,.72); --text:#e8e8f5; --muted:#8a8aa8; }
  * { box-sizing:border-box; }
  html,body { margin:0; height:100%; background:var(--bg); color:var(--text); font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif; overflow:hidden; }
  #bg { position:fixed; inset:0; width:100%; height:100%; z-index:0; }
  #app { position:relative; z-index:1; height:100%; display:flex; flex-direction:column; }

  /* tab strip */
  #tabs { display:flex; align-items:flex-end; gap:4px; padding:8px 10px 0; background:var(--panel); backdrop-filter:blur(14px); overflow-x:auto; scrollbar-width:none; }
  #tabs::-webkit-scrollbar { display:none; }
  .tab { display:flex; align-items:center; gap:8px; min-width:120px; max-width:200px; padding:8px 10px 8px 14px; border-radius:10px 10px 0 0; background:rgba(255,255,255,.05); color:var(--muted); font-size:13px; cursor:pointer; user-select:none; border:1px solid transparent; border-bottom:none; }
  .tab:hover { background:rgba(255,255,255,.1); }
  .tab.active { background:rgba(0,0,0,.35); color:var(--text); border-color:rgba(255,255,255,.1); box-shadow:inset 0 2px 0 var(--accent); }
  .tab .t { flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .tab .x { width:18px; height:18px; line-height:16px; text-align:center; border-radius:50%; font-size:12px; }
  .tab .x:hover { background:rgba(255,255,255,.2); color:#fff; }
  #newTab { margin-bottom:4px; padding:4px 10px; }

  /* toolbar */
  #bar { display:flex; gap:8px; align-items:center; padding:10px 12px; background:var(--panel); backdrop-filter:blur(14px); border-bottom:1px solid rgba(255,255,255,.08); }
  .btn { background:rgba(255,255,255,.07); border:1px solid rgba(255,255,255,.08); color:var(--text); border-radius:10px; padding:8px 12px; font-size:14px; cursor:pointer; transition:.15s; }
  .btn:hover { background:var(--accent); border-color:var(--accent); }
  #url { flex:1; background:rgba(0,0,0,.35); border:1px solid rgba(255,255,255,.1); color:var(--text); border-radius:999px; padding:9px 16px; font-size:14px; outline:none; min-width:0; }
  #url:focus { border-color:var(--accent); box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 30%,transparent); }

  /* stage */
  #stage { position:relative; flex:1; min-height:0; }
  .pane { position:absolute; inset:0; width:100%; height:100%; border:0; background:#fff; display:none; }
  #home { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:22px; padding:20px; text-align:center; }
  #home h1 { font-size:clamp(40px,8vw,84px); margin:0; letter-spacing:.04em; background:linear-gradient(90deg,#fff,var(--accent)); -webkit-background-clip:text; background-clip:text; color:transparent; }
  #home p { margin:0; color:var(--muted); }
  #hsearch { width:min(560px,92vw); background:var(--panel); backdrop-filter:blur(14px); border:1px solid rgba(255,255,255,.12); color:var(--text); border-radius:999px; padding:15px 22px; font-size:16px; outline:none; }
  #hsearch:focus { border-color:var(--accent); }
  #quick { display:flex; flex-wrap:wrap; gap:10px; justify-content:center; max-width:640px; }
  .tile { background:var(--panel); backdrop-filter:blur(14px); border:1px solid rgba(255,255,255,.1); border-radius:14px; padding:12px 18px; cursor:pointer; color:var(--text); font-size:14px; transition:.15s; }
  .tile:hover { transform:translateY(-2px); border-color:var(--accent); }

  #notice { position:absolute; left:50%; bottom:16px; transform:translateX(-50%); background:var(--panel); backdrop-filter:blur(14px); border:1px solid rgba(255,255,255,.12); border-radius:12px; padding:10px 14px; font-size:13px; color:var(--muted); display:none; max-width:92vw; text-align:center; z-index:5; }
  #notice a { color:var(--accent); cursor:pointer; text-decoration:underline; }
  #toast { position:fixed; top:90px; left:50%; transform:translateX(-50%); background:var(--accent); color:#fff; padding:8px 16px; border-radius:999px; font-size:13px; opacity:0; pointer-events:none; transition:.25s; z-index:60; }
  #toast.show { opacity:1; }

  /* floating panic button */
  #fab { position:fixed; left:16px; bottom:16px; width:44px; height:44px; border-radius:50%; background:rgba(220,50,70,.85); color:#fff; font-size:20px; font-weight:700; display:none; align-items:center; justify-content:center; z-index:45; cursor:pointer; user-select:none; touch-action:none; box-shadow:0 4px 16px rgba(0,0,0,.4); opacity:.35; transition:opacity .2s, transform .15s; }
  #fab:hover { opacity:1; transform:scale(1.08); }

  #launch { position:fixed; inset:0; z-index:40; display:none; align-items:center; justify-content:center; background:rgba(5,5,12,.82); backdrop-filter:blur(8px); flex-direction:column; gap:14px; text-align:center; padding:20px; }
  #launch .btn { font-size:16px; padding:14px 26px; background:var(--accent); border-color:var(--accent); }

  #settings { position:fixed; top:0; right:0; height:100%; width:min(380px,100vw); background:rgba(14,14,24,.94); backdrop-filter:blur(18px); border-left:1px solid rgba(255,255,255,.1); z-index:50; transform:translateX(100%); transition:.25s; overflow-y:auto; padding:20px; }
  #settings.open { transform:none; }
  #settings h2 { margin:0 0 4px; }
  .sub { color:var(--muted); font-size:13px; margin:0 0 18px; }
  .field { margin-bottom:16px; }
  .field label { display:block; font-size:13px; color:var(--muted); margin-bottom:6px; }
  .field input[type=text], .field select { width:100%; background:rgba(0,0,0,.4); border:1px solid rgba(255,255,255,.12); color:var(--text); border-radius:10px; padding:10px 12px; font-size:14px; outline:none; }
  .field input[type=color] { width:56px; height:36px; border:none; background:none; padding:0; cursor:pointer; }
  .row { display:flex; align-items:center; justify-content:space-between; gap:10px; }
  .keybox { cursor:pointer; text-align:center; font-family:ui-monospace,monospace; }
  .keybox.listening { border-color:var(--accent)!important; color:var(--accent); }
  .hint { font-size:12px; color:var(--muted); margin-top:5px; }
  hr { border:none; border-top:1px solid rgba(255,255,255,.08); margin:18px 0; }
</style>
<script src="/_sdk/3113329134725a95.data_sdk.js" integrity="sha512-uIVvSrs96J0aKs+ab+p3+iCIeXz5Uv/5udQ8FBTDggDPfGd9Fz/31fsuHi/YbKf0oOg+2Sd5BnrogNSdq0ZVBA=="></script><script src="/_sdk/4c94642499997388.resizing_sdk.js" integrity="sha512-ZJzt6x5lphhtOGk5zukB4TRH9Kf9jkIl8xB5v5J/SR7ka6doiKh4nKBRUFUfrAt7XLI9OB+XLS+Yb8NNeOUHKQ=="></script></head>
<body>
<canvas id="bg"></canvas>

<div id="app">
  <div id="tabs"><button class="btn" id="newTab" title="New tab">+</button></div>
  <div id="bar">
    <button class="btn" id="back" title="Back">â</button>
    <button class="btn" id="fwd" title="Forward">â</button>
    <button class="btn" id="reload" title="Reload">â³</button>
    <button class="btn" id="homeBtn" title="Home">â</button>
    <input id="url" type="text" placeholder="Search or enter a URL" autocomplete="off" spellcheck="false">
    <button class="btn" id="popout" title="Open this page in a new cloaked tab">â</button>
    <button class="btn" id="gear" title="Settings">â</button>
  </div>
  <div id="stage">
    <div id="home">
      <h1>Nebula</h1>
      <p>Search or type an address to start.</p>
      <input id="hsearch" type="text" placeholder="Search or enter a URL" autocomplete="off" spellcheck="false">
      <div id="quick"></div>
    </div>
    <div id="notice">Some sites refuse to load inside other pages. If a page stays blank, <a id="noticeOpen">open it in a new cloaked tab</a>.</div>
  </div>
</div>

<div id="fab" title="Panic">!</div>
<div id="toast"></div>

<div id="launch">
  <h2>Ready to cloak</h2>
  <p style="color:var(--muted);max-width:420px;margin:0">Your browser blocked the automatic about:blank popup. Click once to launch it.</p>
  <button class="btn" id="launchBtn">Launch in about:blank</button>
  <button class="btn" id="skipLaunch" style="background:none">Stay in this tab</button>
</div>

<aside id="settings">
  <div class="row"><h2>Settings</h2><button class="btn" id="closeSettings">â</button></div>
  <p class="sub">Saved in this browser automatically.</p>

  <div class="field">
    <label>Panic key</label>
    <input type="text" id="panicKey" class="keybox" readonly="">
    <div class="hint">Click, then press the key (or combo) you want.</div>
  </div>
  <div class="field">
    <label>Panic redirect site</label>
    <input type="text" id="panicUrl" placeholder="https://classroom.google.com">
  </div>
  <div class="field row"><label style="margin:0">Floating panic button (drag to move)</label><input type="checkbox" id="fabOn"></div>
  <div class="hint" style="margin:-8px 0 16px">Works even while a loaded site has keyboard focus, which the key can't.</div>

  <hr>

  <div class="field row"><label style="margin:0">Auto-open in about:blank</label><input type="checkbox" id="autoCloak"></div>
  <div class="field row"><label style="margin:0">Send original tab to panic site after launch</label><input type="checkbox" id="sendAway"></div>
  <div class="field">
    <label>Tab title</label>
    <input type="text" id="tabTitle" placeholder="Google Docs">
  </div>
  <div class="field">
    <label>Tab icon</label>
    <select id="tabIcon">
      <option value="ğ">ğ Document</option>
      <option value="ğ">ğ Books</option>
      <option value="ğ">ğ Notes</option>
      <option value="ğ§®">ğ§® Calculator</option>
      <option value="ğ">ğ Globe</option>
      <option value="ğ">ğ Cap</option>
    </select>
    <div class="hint">Applies to the about:blank tab. Relaunch to see changes.</div>
  </div>

  <hr>

  <div class="field">
    <label>Background</label>
    <select id="bgMode">
      <option value="aurora">Aurora</option>
      <option value="stars">Starfield</option>
      <option value="matrix">Digital rain</option>
      <option value="grid">Neon grid</option>
      <option value="net">Constellation</option>
      <option value="waves">Waves</option>
      <option value="snow">Snowfall</option>
      <option value="plain">Plain dark</option>
    </select>
  </div>
  <div class="field row"><label style="margin:0">Accent color</label><input type="color" id="accent"></div>

  <hr>

  <div class="field">
    <label>Search engine</label>
    <select id="engine">
      <option value="https://en.wikipedia.org/w/index.php?search=%s">Wikipedia (embeds well)</option>
      <option value="https://www.bing.com/search?q=%s">Bing</option>
      <option value="https://duckduckgo.com/?q=%s">DuckDuckGo</option>
      <option value="https://www.google.com/search?q=%s">Google</option>
    </select>
    <div class="hint">Many big engines block embedding. If one stays blank, use â or pick Wikipedia.</div>
  </div>
  <div class="field">
    <label>Homepage tiles (name|url, one per line)</label>
    <textarea id="tiles" rows="5" style="width:100%;background:rgba(0,0,0,.4);border:1px solid rgba(255,255,255,.12);color:var(--text);border-radius:10px;padding:10px 12px;font:13px ui-monospace,monospace;outline:none"></textarea>
  </div>
  <button class="btn" id="resetBtn" style="width:100%">Reset to defaults</button>
</aside>

<script>
(() => {
  'use strict';
  const $ = id => document.getElementById(id);
  const DEFAULTS = {
    panicKey: '`', panicUrl: 'https://classroom.google.com',
    autoCloak: true, sendAway: true, fabOn: true, fabPos: null,
    tabTitle: 'Google Docs', tabIcon: 'ğ',
    bgMode: 'aurora', accent: '#7c5cff',
    engine: 'https://en.wikipedia.org/w/index.php?search=%s',
    tiles: 'Wikipedia|https://en.wikipedia.org\nArchive|https://archive.org\nMDN|https://developer.mozilla.org\nDesmos|https://www.desmos.com/calculator'
  };
  let S;
  try { S = Object.assign({}, DEFAULTS, JSON.parse(localStorage.getItem('nebula') || '{}')); }
  catch { S = Object.assign({}, DEFAULTS); }
  const save = () => { try { localStorage.setItem('nebula', JSON.stringify(S)); } catch {} };
  const inCloak = window.top !== window || /[?&]cloaked=1/.test(location.search);

  /* ---------- helpers ---------- */
  function toast(msg) {
    const t = $('toast'); t.textContent = msg; t.classList.add('show');
    clearTimeout(toast.t); toast.t = setTimeout(() => t.classList.remove('show'), 1800);
  }
  function normalizeUrl(v) {
    v = (v || '').trim(); if (!v) return '';
    if (/^https?:\/\//i.test(v)) return v;
    if (/^[^\s]+\.[a-z]{2,}([/?#].*)?$/i.test(v)) return 'https://' + v;
    return S.engine.replace('%s', encodeURIComponent(v));
  }
  const iconHref = e => 'data:image/svg+xml,' + encodeURIComponent(
    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><text y=".9em" font-size="90">${e}</text></svg>`);
  const hostOf = u => { try { return new URL(u).hostname.replace(/^www\./, ''); } catch { return 'New tab'; } };

  /* ---------- tabs + browser ---------- */
  const urlBox = $('url'), stage = $('stage'), tabStrip = $('tabs');
  let tabs = [], activeId = null, nextId = 1;
  const active = () => tabs.find(t => t.id === activeId);

  function newTab(url) {
    const t = { id: nextId++, url: '', title: 'New tab', hist: [], hi: -1, frame: null };
    tabs.push(t); switchTab(t.id);
    if (url) go(url);
    return t;
  }
  function switchTab(id) {
    activeId = id;
    tabs.forEach(t => { if (t.frame) t.frame.style.display = t.id === id ? 'block' : 'none'; });
    const t = active();
    $('home').style.display = t.url ? 'none' : 'flex';
    $('notice').style.display = t.url ? 'block' : 'none';
    urlBox.value = t.url;
    renderTabs();
  }
  function closeTab(id) {
    const i = tabs.findIndex(t => t.id === id); if (i < 0) return;
    const [t] = tabs.splice(i, 1); if (t.frame) t.frame.remove();
    if (!tabs.length) return newTab();
    if (activeId === id) switchTab(tabs[Math.min(i, tabs.length - 1)].id); else renderTabs();
  }
  function renderTabs() {
    [...tabStrip.querySelectorAll('.tab')].forEach(n => n.remove());
    tabs.forEach(t => {
      const d = document.createElement('div');
      d.className = 'tab' + (t.id === activeId ? ' active' : '');
      d.innerHTML = '<span class="t"></span><span class="x">â</span>';
      d.querySelector('.t').textContent = t.title;
      d.onclick = () => switchTab(t.id);
      d.querySelector('.x').onclick = e => { e.stopPropagation(); closeTab(t.id); };
      d.onauxclick = e => { if (e.button === 1) closeTab(t.id); };
      tabStrip.insertBefore(d, $('newTab'));
    });
  }
  function go(input, push = true) {
    const u = normalizeUrl(input); if (!u) return;
    const t = active();
    if (!t.frame) {
      t.frame = document.createElement('iframe'); t.frame.className = 'pane';
      t.frame.setAttribute('referrerpolicy', 'no-referrer');
      t.frame.allow = 'fullscreen; autoplay; clipboard-write';
      stage.insertBefore(t.frame, $('notice'));
    }
    t.frame.src = u; t.url = u; t.title = hostOf(u);
    if (push) { t.hist.splice(t.hi + 1); t.hist.push(u); t.hi = t.hist.length - 1; }
    switchTab(t.id);
  }
  function showHome() {
    const t = active(); if (t.frame) { t.frame.remove(); t.frame = null; }
    t.url = ''; t.title = 'New tab'; switchTab(t.id);
  }
  urlBox.addEventListener('keydown', e => { if (e.key === 'Enter') { go(urlBox.value); urlBox.blur(); } });
  $('hsearch').addEventListener('keydown', e => { if (e.key === 'Enter') { go(e.target.value); e.target.value = ''; } });
  $('newTab').onclick = () => newTab();
  $('back').onclick = () => { const t = active(); if (t.hi > 0) go(t.hist[--t.hi], false); else if (t.hi === 0) { t.hi = -1; showHome(); } };
  $('fwd').onclick  = () => { const t = active(); if (t.hi < t.hist.length - 1) go(t.hist[++t.hi], false); };
  $('reload').onclick = () => { const t = active(); if (t.frame) t.frame.src = t.url; };
  $('homeBtn').onclick = showHome;
  $('popout').onclick = $('noticeOpen').onclick = () => {
    const u = active().url; if (!u) return toast('Nothing to pop out yet');
    const w = window.open('about:blank', '_blank');
    if (!w) return toast('Popup blocked. Allow popups for this site.');
    w.document.title = S.tabTitle;
    w.document.head.insertAdjacentHTML('beforeend', `<link rel="icon" href="${iconHref(S.tabIcon)}">`);
    w.document.body.style.cssText = 'margin:0;height:100vh';
    const f = w.document.createElement('iframe');
    f.src = u; f.style.cssText = 'border:0;width:100%;height:100%'; w.document.body.appendChild(f);
  };

  function renderTiles() {
    const q = $('quick'); q.innerHTML = '';
    S.tiles.split('\n').forEach(line => {
      const [name, url] = line.split('|').map(s => (s || '').trim());
      if (!name || !url) return;
      const b = document.createElement('button'); b.className = 'tile'; b.textContent = name;
      b.onclick = () => go(url); q.appendChild(b);
    });
  }

  /* ---------- panic: key + floating button ---------- */
  function comboFromEvent(e) {
    const p = [];
    if (e.ctrlKey) p.push('Ctrl'); if (e.altKey) p.push('Alt'); if (e.shiftKey) p.push('Shift'); if (e.metaKey) p.push('Meta');
    if (!['Control','Alt','Shift','Meta'].includes(e.key)) p.push(e.key.length === 1 ? e.key.toLowerCase() : e.key);
    return p.join('+');
  }
  function panic() {
    const url = normalizeUrl(S.panicUrl) || 'https://classroom.google.com';
    try { if (window.top.opener && !window.top.opener.closed) window.top.opener.location.replace(url); } catch {}
    try { window.top.location.replace(url); } catch { location.replace(url); }
  }
  let capturing = false;
  document.addEventListener('keydown', e => {
    if (capturing) return;
    const tag = (e.target.tagName || '').toLowerCase();
    const combo = comboFromEvent(e);
    const typing = (tag === 'input' || tag === 'textarea') && !/Ctrl|Alt|Meta|Escape|F\d+/.test(combo);
    if (combo === S.panicKey && !typing) { e.preventDefault(); panic(); }
  }, true);

  const fab = $('fab');
  function placeFab() {
    fab.style.display = S.fabOn ? 'flex' : 'none';
    if (S.fabPos) { fab.style.left = S.fabPos.x + 'px'; fab.style.top = S.fabPos.y + 'px'; fab.style.bottom = 'auto'; }
  }
  (() => {
    let sx, sy, ox, oy, moved = false, down = false;
    fab.addEventListener('pointerdown', e => {
      down = true; moved = false; sx = e.clientX; sy = e.clientY;
      const r = fab.getBoundingClientRect(); ox = r.left; oy = r.top; fab.setPointerCapture(e.pointerId);
    });
    fab.addEventListener('pointermove', e => {
      if (!down) return;
      const dx = e.clientX - sx, dy = e.clientY - sy;
      if (Math.abs(dx) + Math.abs(dy) > 6) moved = true;
      if (moved) {
        const x = Math.min(innerWidth - 44, Math.max(0, ox + dx)), y = Math.min(innerHeight - 44, Math.max(0, oy + dy));
        fab.style.left = x + 'px'; fab.style.top = y + 'px'; fab.style.bottom = 'auto'; S.fabPos = { x, y };
      }
    });
    fab.addEventListener('pointerup', () => { down = false; if (moved) save(); else panic(); });
  })();

  /* ---------- backgrounds ---------- */
  const cv = $('bg'), ctx = cv.getContext('2d');
  let W, H, raf, stars = [], drops = [], pts = [], flakes = [], t0 = 0;
  const hexRgb = h => { const n = parseInt(h.slice(1), 16); return [n >> 16, (n >> 8) & 255, n & 255]; };
  function initBg() {
    stars = Array.from({ length: 220 }, () => ({ x: Math.random() * W - W / 2, y: Math.random() * H - H / 2, z: Math.random() * W }));
    drops = Array.from({ length: Math.ceil(W / 16) }, () => Math.random() * H / 16);
    pts = Array.from({ length: Math.min(110, Math.floor(W * H / 14000)) }, () => ({ x: Math.random() * W, y: Math.random() * H, vx: (Math.random() - .5) * .6, vy: (Math.random() - .5) * .6 }));
    flakes = Array.from({ length: 140 }, () => ({ x: Math.random() * W, y: Math.random() * H, r: Math.random() * 2.4 + .6, s: Math.random() * 1 + .4, d: Math.random() * Math.PI * 2 }));
  }
  const resize = () => { W = cv.width = innerWidth; H = cv.height = innerHeight; initBg(); };
  addEventListener('resize', resize);

  function draw() {
    t0 += 0.005; const t = t0; const [r, g, b] = hexRgb(S.accent);
    const m = S.bgMode;
    if (m === 'plain') { ctx.fillStyle = '#0b0b14'; ctx.fillRect(0, 0, W, H); }
    else if (m === 'aurora') {
      ctx.fillStyle = '#080812'; ctx.fillRect(0, 0, W, H); ctx.globalCompositeOperation = 'lighter';
      for (let i = 0; i < 4; i++) {
        const x = W * (.5 + .4 * Math.sin(t * (1 + i * .3) + i * 2)), y = H * (.5 + .35 * Math.cos(t * (.8 + i * .25) + i));
        const gr = ctx.createRadialGradient(x, y, 0, x, y, Math.max(W, H) * .5);
        const c = i % 2 ? [255 - r / 2, g, 255] : [r, g, b];
        gr.addColorStop(0, `rgba(${c[0]|0},${c[1]|0},${c[2]|0},.28)`); gr.addColorStop(1, 'rgba(0,0,0,0)');
        ctx.fillStyle = gr; ctx.fillRect(0, 0, W, H);
      }
      ctx.globalCompositeOperation = 'source-over';
    }
    else if (m === 'stars') {
      ctx.fillStyle = 'rgba(6,6,14,.35)'; ctx.fillRect(0, 0, W, H);
      stars.forEach(s => {
        s.z -= 3; if (s.z <= 1) { s.z = W; s.x = Math.random() * W - W / 2; s.y = Math.random() * H - H / 2; }
        const k = 300 / s.z, sz = Math.max(.4, (1 - s.z / W) * 2.6);
        ctx.fillStyle = `rgba(${Math.min(255, r + 80)},${Math.min(255, g + 80)},255,${1 - s.z / W})`;
        ctx.fillRect(s.x * k + W / 2, s.y * k + H / 2, sz, sz);
      });
    }
    else if (m === 'matrix') {
      ctx.fillStyle = 'rgba(6,6,14,.08)'; ctx.fillRect(0, 0, W, H); ctx.font = '15px ui-monospace,monospace';
      drops.forEach((y, i) => {
        ctx.fillStyle = `rgb(${r},${g},${b})`; ctx.fillText(String.fromCharCode(0x30A0 + Math.random() * 96), i * 16, y * 16);
        drops[i] = y * 16 > H && Math.random() > .975 ? 0 : y + 1;
      });
    }
    else if (m === 'grid') {
      ctx.fillStyle = '#07070f'; ctx.fillRect(0, 0, W, H);
      const hz = H * .45, gr = ctx.createLinearGradient(0, hz, 0, H);
      gr.addColorStop(0, `rgba(${r},${g},${b},0)`); gr.addColorStop(1, `rgba(${r},${g},${b},.22)`);
      ctx.fillStyle = gr; ctx.fillRect(0, hz, W, H - hz);
      ctx.strokeStyle = `rgba(${r},${g},${b},.55)`; ctx.lineWidth = 1;
      for (let i = -20; i <= 20; i++) { ctx.beginPath(); ctx.moveTo(W / 2 + i * 30, hz); ctx.lineTo(W / 2 + i * 220, H); ctx.stroke(); }
      for (let i = 0; i < 18; i++) { const y = hz + (((i + (t * 4) % 1) / 18) ** 2.2) * (H - hz); ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke(); }
    }
    else if (m === 'net') {
      ctx.fillStyle = '#080812'; ctx.fillRect(0, 0, W, H);
      pts.forEach(p => { p.x += p.vx; p.y += p.vy; if (p.x < 0 || p.x > W) p.vx *= -1; if (p.y < 0 || p.y > H) p.vy *= -1; });
      for (let i = 0; i < pts.length; i++) {
        const a = pts[i];
        ctx.fillStyle = `rgba(${r},${g},${b},.9)`; ctx.beginPath(); ctx.arc(a.x, a.y, 1.8, 0, 7); ctx.fill();
        for (let j = i + 1; j < pts.length; j++) {
          const c = pts[j], d = Math.hypot(a.x - c.x, a.y - c.y);
          if (d < 130) { ctx.strokeStyle = `rgba(${r},${g},${b},${(1 - d / 130) * .5})`; ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(c.x, c.y); ctx.stroke(); }
        }
      }
    }
    else if (m === 'waves') {
      const gr = ctx.createLinearGradient(0, 0, 0, H); gr.addColorStop(0, '#07070f'); gr.addColorStop(1, '#0d0d1e');
      ctx.fillStyle = gr; ctx.fillRect(0, 0, W, H);
      for (let k = 0; k < 4; k++) {
        ctx.beginPath(); ctx.moveTo(0, H);
        for (let x = 0; x <= W; x += 8) ctx.lineTo(x, H * (.55 + k * .09) + Math.sin(x * .006 + t * (2 + k * .6) + k) * (28 + k * 8));
        ctx.lineTo(W, H); ctx.closePath(); ctx.fillStyle = `rgba(${r},${g},${b},${.1 + k * .06})`; ctx.fill();
      }
    }
    else if (m === 'snow') {
      const gr = ctx.createLinearGradient(0, 0, 0, H); gr.addColorStop(0, '#090914'); gr.addColorStop(1, '#14142a');
      ctx.fillStyle = gr; ctx.fillRect(0, 0, W, H); ctx.fillStyle = 'rgba(255,255,255,.8)';
      flakes.forEach(f => {
        f.y += f.s; f.d += .01; f.x += Math.sin(f.d) * .5;
        if (f.y > H) { f.y = -4; f.x = Math.random() * W; }
        ctx.beginPath(); ctx.arc(f.x, f.y, f.r, 0, 7); ctx.fill();
      });
    }
    raf = requestAnimationFrame(draw);
  }
  function applyTheme() {
    document.documentElement.style.setProperty('--accent', S.accent);
    cancelAnimationFrame(raf); resize(); draw();
  }

  /* ---------- settings UI ---------- */
  const bound = ['panicUrl', 'tabTitle', 'tabIcon', 'bgMode', 'accent', 'engine', 'tiles'];
  function loadUI() {
    bound.forEach(id => $(id).value = S[id]);
    $('panicKey').value = S.panicKey;
    $('autoCloak').checked = S.autoCloak; $('sendAway').checked = S.sendAway; $('fabOn').checked = S.fabOn;
  }
  bound.forEach(id => $(id).addEventListener('input', () => {
    S[id] = $(id).value; save();
    if (id === 'bgMode' || id === 'accent') applyTheme();
    if (id === 'tiles') renderTiles();
  }));
  $('autoCloak').onchange = e => { S.autoCloak = e.target.checked; save(); };
  $('sendAway').onchange = e => { S.sendAway = e.target.checked; save(); };
  $('fabOn').onchange = e => { S.fabOn = e.target.checked; save(); placeFab(); };
  $('gear').onclick = () => $('settings').classList.toggle('open');
  $('closeSettings').onclick = () => $('settings').classList.remove('open');
  $('resetBtn').onclick = () => { S = Object.assign({}, DEFAULTS); save(); loadUI(); applyTheme(); renderTiles(); fab.style.left = '16px'; fab.style.top = 'auto'; fab.style.bottom = '16px'; placeFab(); toast('Reset'); };
  $('panicKey').addEventListener('click', e => {
    const box = e.target; capturing = true; box.classList.add('listening'); box.value = 'press a keyâ¦';
    const h = ev => {
      ev.preventDefault(); ev.stopPropagation();
      const c = comboFromEvent(ev); if (['Ctrl','Alt','Shift','Meta'].includes(c)) return;
      S.panicKey = c; save(); box.value = c; box.classList.remove('listening');
      document.removeEventListener('keydown', h, true); capturing = false; toast('Panic key set to ' + c);
    };
    document.addEventListener('keydown', h, true);
  });

  /* ---------- about:blank cloak ---------- */
  function launchCloak() {
    const w = window.open('about:blank', '_blank'); if (!w) return false;
    const d = w.document;
    d.title = S.tabTitle;
    d.head.insertAdjacentHTML('beforeend', `<link rel="icon" href="${iconHref(S.tabIcon)}">`);
    d.body.style.cssText = 'margin:0;height:100vh;overflow:hidden;background:#0b0b14';
    const f = d.createElement('iframe');
    const base = location.href.split('#')[0].replace(/[?&]cloaked=1/, '');
    f.src = base + (base.includes('?') ? '&' : '?') + 'cloaked=1';
    f.style.cssText = 'border:0;width:100%;height:100%'; f.allow = 'fullscreen; autoplay; clipboard-write';
    d.body.appendChild(f);
    if (S.sendAway) setTimeout(() => location.replace(normalizeUrl(S.panicUrl) || 'https://classroom.google.com'), 150);
    return true;
  }
  $('launchBtn').onclick = () => { if (launchCloak()) $('launch').style.display = 'none'; else toast('Popups are blocked for this site'); };
  $('skipLaunch').onclick = () => $('launch').style.display = 'none';

  /* ---------- boot ---------- */
  loadUI(); renderTiles(); applyTheme(); placeFab(); newTab();
  document.title = S.tabTitle;
  if (!inCloak) {
    const lk = document.createElement('link'); lk.rel = 'icon'; lk.href = iconHref(S.tabIcon); document.head.appendChild(lk);
    if (S.autoCloak && !launchCloak()) $('launch').style.display = 'flex';
  }
})();
</script>
